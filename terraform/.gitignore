# Downloaded provider plugins + init metadata — large, machine-specific,
# always regenerated by `terraform init`. Never commit this.
.terraform/

# State files — the source of truth for what Terraform currently owns.
# Contains real resource attributes (can include sensitive values) and
# must never be hand-edited. For this lab we're using local state
# (no remote backend), so it lives on disk here — keep it out of git.
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Crash logs, if a run ever fails ungracefully.
crash.log
crash.*.log

# Per-user variable overrides some people keep locally (e.g. real SSH key
# paths, host-specific tweaks). We'll define a committed *.tfvars.example
# later, but any real *.tfvars stays local.
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI-level config that can carry credentials.
*.terraformrc
terraform.rc
